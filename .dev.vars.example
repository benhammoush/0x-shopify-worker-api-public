JUPITER_API_KEY=replace-with-jupiter-api-key
SHOPIFY_ADMIN_CLIENT_ID=replace-with-dev-dashboard-client-id
SHOPIFY_ADMIN_CLIENT_SECRET=replace-with-dev-dashboard-client-secret
